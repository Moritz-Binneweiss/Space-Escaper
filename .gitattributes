# =============================================================
#  Unity YAML assets  --  text, so they stay diffable
# =============================================================
# The project uses Force Text serialization (EditorSettings:
# m_SerializationMode: 2), which makes all of these plain YAML. Keeping them
# out of LFS means `git diff` actually shows what changed in a scene or a
# prefab, and Git stores deltas instead of a full copy per change.
#
# merge=binary is deliberate: Git's line-based merge produces broken YAML on
# conflicts. This makes a conflict fail loudly instead of silently corrupting
# an asset - resolve it by picking one side, or set up Unity's SmartMerge
# (UnityYAMLMerge) as a merge driver.
*.unity text eol=lf merge=binary
*.prefab text eol=lf merge=binary
*.asset text eol=lf merge=binary
*.mat text eol=lf merge=binary
*.anim text eol=lf merge=binary
*.controller text eol=lf merge=binary
*.overrideController text eol=lf merge=binary
*.physicMaterial text eol=lf merge=binary
*.physicMaterial2D text eol=lf merge=binary
*.playable text eol=lf merge=binary
*.signal text eol=lf merge=binary
*.mixer text eol=lf merge=binary
*.cubemap text eol=lf merge=binary
*.flare text eol=lf merge=binary
*.guiskin text eol=lf merge=binary
*.mask text eol=lf merge=binary
*.terrainlayer text eol=lf merge=binary
*.spriteatlas text eol=lf merge=binary
*.shadergraph text eol=lf merge=binary
*.shadersubgraph text eol=lf merge=binary
*.meta text eol=lf merge=binary

